# Which backend the app uses. Unset: the in-app demo with sample data (no server needed).
# Set: the Global Connect server (see server/). Use "/" when the server serves the web app itself.
# This is an address, not a secret. Provider credentials live only in server/.env.
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Defaults for the in-app demo backend (ignored when EXPO_PUBLIC_API_URL is set). All optional. Copy to .env.local to use.
# These are developer switches, not secrets. There are no secrets in this app.
EXPO_PUBLIC_MOCK_LATENCY_MS=350
EXPO_PUBLIC_MOCK_FAILURE_RATE=0
# none | network | unauthorized | forbidden | rate_limited | server | malformed | wrong_shape | lost_response | applied_late
EXPO_PUBLIC_MOCK_FORCE_ERROR=none
EXPO_PUBLIC_MOCK_QUOTE_TTL_S=30
EXPO_PUBLIC_MOCK_OFFLINE=0
# 1 = forced errors hit only requests that change something (reads keep working)
EXPO_PUBLIC_MOCK_FAIL_WRITES_ONLY=0
# 1 exposes globalThis.__GC_DEV__ in a production build, for automated stress tests only.
EXPO_PUBLIC_EXPOSE_DEV_GLOBALS=0
