# Copy to server/.env (git-ignored).

# THE SERVER IS STRICT BY DEFAULT. Without the next line it refuses mock providers,
# sample data, printed activation codes, the console "outbox" and a generated encryption key,
# and (because this repository has no live provider transport yet; it does have a real
# mailer, SMTP, see below) it will not start at all. For local development and demonstrations only:
APP_ENV=development

PORT=3001
# In development the server listens on this machine only (127.0.0.1) unless HOST says otherwise; a GitHub Codespace
# forwards its port from there. A development server on any other address must be behind the demo gate
# (DEMO_ACCESS_PASSWORD), or you must say DEV_OPEN_ON_NETWORK=1 (it then warns loudly). Outside development: 0.0.0.0.
# HOST=127.0.0.1

# Web origins allowed to call the API (comma-separated, exact). Not needed when
# the server serves the web build itself (npm run demo).
CORS_ORIGINS=http://localhost:8081
# Where client activation and password-reset links point: the app's public address.
# Outside development it is REQUIRED and must be https (there is no default).
APP_URL=http://localhost:8081
# Public address of this server; the ops console is at <OPS_URL>/ops. In development it
# defaults to http://localhost:<PORT> (or APP_URL when the server also serves the web
# app). Outside development it is required and must be https.
# OPS_URL=https://ops.example.com

# Reverse proxies whose X-Forwarded-For is believed: their addresses or CIDR ranges
# (preferred), or a number of hops (at most 3). 0 = none. "true" is not accepted. A hop
# count is only right when the server cannot be reached except through that many proxies.
TRUST_PROXY=0
# TRUST_PROXY=10.0.0.0/8

# Key for values the server signs (the ops console's pre-login CSRF anchor). Required
# outside development; in development a random one is made at each start. Same rules as
# ADMIN_TOKEN. Generate one with:  openssl rand -base64 32
# SERVER_SECRET=

# Email domains staff accounts may be created for (comma-separated). Required outside
# development; the development default is globalconnect.example.
# STAFF_EMAIL_DOMAINS=globalconnect.co.uk

# Operator commands (`npm run invite`, `npm run create-ops-admin`, `npm run break-glass`). They are served on
# 127.0.0.1:<ADMIN_PORT> only, never on the public port, and need this token. Leave it
# unset to switch them off. The server refuses placeholders, short or repetitive values,
# alphabet and keyboard sequences, and anything that does not look randomly generated.
# Generate one with:  openssl rand -base64 32
# ADMIN_TOKEN=
ADMIN_PORT=3002

# How many staff an ops-console action takes.
#   single      (default) the member of staff who starts an action carries it out, after a
#               confirmation page (and their password for the highest-impact actions).
#               One staff account, or whoever takes it over, can then do everything alone:
#               set OPS_OVERSIGHT_EMAILS and restrict who can reach /ops.
#   two-person  sensitive actions only make a request; a second member of staff approves it.
# OPS_APPROVALS=single
# Who is emailed a short notice of every high-impact ops action (comma-separated; typically
# a director who is NOT the person using the console). Can only be set here, never in the
# console. Unset: nobody is told, and the console and the start-up log say so.
# OPS_OVERSIGHT_EMAILS=director@your-domain.example

# The SQLite database file. REQUIRED outside development. In development, unset = an
# in-memory database that is forgotten when the server stops (npm run demo sets it to
# .demo-data/globalconnect.sqlite).
# DATABASE_PATH=/var/lib/globalconnect/globalconnect.sqlite
# The file and its folder must be for the server's user only (chmod 600 / 700): the server refuses to start
# otherwise. One server process per database. A database once started in development mode is refused outside it.

# Encrypts authenticator keys in the database and keys the audit log's hash chain.
# REQUIRED outside development: 32 random bytes in base64 (openssl rand -base64 32).
# Keep it out of the database and out of its backups. In development, with a database
# file and no key here, one is generated and kept in <DATABASE_PATH>.dev-key.
# DATA_ENCRYPTION_KEY=
# Older keys still accepted for reading, comma-separated (see "Rotating the key" in the README).
# DATA_ENCRYPTION_KEY_PREVIOUS=

# A DEMO ON A PUBLIC ADDRESS (see docs/DEPLOY-DEMO.md). When set, nothing but /healthz is
# served until the visitor has typed this password on a gate page. REQUIRED, together with
# real SERVER_SECRET, ADMIN_TOKEN, DATA_ENCRYPTION_KEY and DATABASE_PATH, whenever
# APP_ENV=development runs on Fly.io or on any address that is not localhost or a Codespace.
# At least 12 characters.
# DEMO_ACCESS_PASSWORD=
# First start of a public demo only: print the sample accounts' activation codes to the log.
# DEMO_SETUP_CODES=1

# How long a payment may wait for approval before it expires and is not sent (hours).
# PAYMENT_APPROVAL_HOURS=48

# 1 = booking a conversion between the client's own balances also needs a fresh code.
STEP_UP_CONVERSIONS=0

# Provider API credentials. Server-side only; they never reach the app. Required outside
# development (where the mock providers accept anything).
# CURRENCYCLOUD_LOGIN_ID=
# CURRENCYCLOUD_API_KEY=
# EQUALS_API_KEY=

# A payment whose sending went unanswered and was then refused is looked for at the provider (by its key) for this
# long before it is called failed. Default 72.
# PAYMENT_RECONCILE_HOURS=72
# Payee fields left out of the payee digest, by name, beyond each adapter's own short list (a.b = b inside a).
# Only for a field a provider changes on its own; leaving a field out is a decision about where money may go.
# PAYEE_DIGEST_IGNORE_CURRENCYCLOUD=
# PAYEE_DIGEST_IGNORE_EQUALS=
# ONE START ONLY, and only when the server refuses to start because the end of its audit log is not signed and
# no command can be run: the end label from that refusal. Prefer "npm run audit:reseal". Remove it straight after.
# AUDIT_ACCEPT_LOG_END=

# EMAIL. Without SMTP_HOST, development prints every email in the server console; outside development the server
# will not start. TLS is required (starttls, or tls on port 465).
# SMTP_HOST=smtp.your-email-service.example
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@your-domain.example
# MAIL_REPLY_TO=

# An approved CLIENT authenticator reset waits this long before anything changes, COUNTED FROM WHEN THE MAIL SERVER
# ACCEPTED THE WARNING to the client (not from the approval). The client can cancel it by signing in; any ops admin can cancel it. Default 24. At least 1 outside development.
# AUTHENTICATOR_RESET_DELAY_HOURS=24

# FX MARGIN. A client only ever sees their own rate (after the margin).
# The margin, in basis points (100 = 1%), for a company that has no margin configuration of its own (set per
# company in the ops console). REQUIRED outside development: there is no default. In development it is 50,
# which is a sample, not Global Connect's pricing.
# DEFAULT_MARGIN_BPS=
# Where the margin is applied, per provider. "server": this server works out the client's rate from the
# provider's. "provider": the provider already returns the client's rate with the markup configured on its
# side, and the server adds nothing on top.
# MARGIN_APPLIED_BY_CURRENCYCLOUD=server
# MARGIN_APPLIED_BY_EQUALS=server
# How long a provider's rate for a pair is reused for indicative rates and rate alerts, in seconds (default 5).
# RATE_CACHE_SECONDS=5
# Mock providers only: the sample rates move over time (a deterministic walk). 0 turns that off.
# MOCK_MOVING_RATES=1

# RATE ALERTS AND NOTIFICATIONS.
# How often rate alerts are checked against each company's client rate, in seconds (default 60; 10 is handy in a demo).
# ALERT_CHECK_SECONDS=60
# Most rate alerts one person can have (default 20).
# ALERTS_PER_USER=20
# How long before a held payment expires its creator and approvers are told, in hours (default 6; 0 = never).
# PAYMENT_EXPIRY_WARNING_HOURS=6
# Most notifications one person is sent in an hour (default 60).
# NOTIFICATIONS_PER_USER_PER_HOUR=60
# Email: payment notifications to one address per hour (default 20, 2 to 200), and any one class of email
# overall per hour (default 1000, 50 to 100000). Security notices and links have their own fixed allowances.
# MAIL_PER_RECIPIENT_PER_HOUR=20
# MAIL_GLOBAL_PER_HOUR=1000
