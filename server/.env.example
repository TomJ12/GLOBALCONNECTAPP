# Copy to server/.env (git-ignored).

# THE SERVER IS STRICT BY DEFAULT. Without the next line it refuses mock providers,
# sample data, printed activation codes, the console "outbox" and the JSON file store,
# and (because this repository has no live provider transport and no real mailer yet)
# it will not start at all. For local development and demonstrations only:
APP_ENV=development

PORT=3001
HOST=0.0.0.0

# Web origins allowed to call the API (comma-separated, exact). Not needed when
# the server serves the web build itself (npm run demo).
CORS_ORIGINS=http://localhost:8081
# Where client activation links point: the app's public address.
APP_URL=http://localhost:8081
# Public address of this server; the ops console is at <OPS_URL>/ops. In development it
# defaults to http://localhost:<PORT> (or APP_URL when the server also serves the web
# app). Outside development it is required and must be https.
# OPS_URL=https://ops.example.com

# Reverse proxies whose X-Forwarded-For is believed: their addresses or CIDR ranges
# (preferred), or a number of hops. 0 = none. "true" is not accepted. A hop count is
# only right when the server cannot be reached except through that many proxies.
TRUST_PROXY=0
# TRUST_PROXY=10.0.0.0/8

# Operator commands (`npm run invite`, `npm run create-ops-admin`). They are served on
# 127.0.0.1:<ADMIN_PORT> only, never on the public port, and need this token. Leave it
# unset to switch them off. The server refuses placeholders and short or repetitive
# values. Generate one with:  openssl rand -base64 32
# ADMIN_TOKEN=
ADMIN_PORT=3002

# Sensitive ops-console actions need a second staff member. "off" is accepted only with
# APP_ENV=development.
# FOUR_EYES=off

# LOCAL DEMO ONLY (APP_ENV=development): keep accounts in this JSON file across
# restarts. It holds password hashes and authenticator keys in plain form.
# DATA_FILE=../.demo-data/accounts.json

# 1 = booking a conversion between the client's own balances also needs a fresh code.
STEP_UP_CONVERSIONS=0

# Provider API credentials. Server-side only; they never reach the app. Required outside
# development (where the mock providers accept anything).
# CURRENCYCLOUD_LOGIN_ID=
# CURRENCYCLOUD_API_KEY=
# EQUALS_API_KEY=
