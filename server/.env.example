# Copy to server/.env (git-ignored). Every value below is a placeholder.

PORT=3001
HOST=0.0.0.0
# production | development. In production the server never prints activation codes
# and refuses to start without provider credentials.
NODE_ENV=development

# Web origins allowed to call the API (comma-separated, exact). Not needed when
# the server serves the web build itself (npm run demo).
CORS_ORIGINS=http://localhost:8081
# Where activation links point: the app's public address.
APP_URL=http://localhost:8081
# 1 when the server sits behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

# Public address of this server; the ops console is at <OPS_URL>/ops. Defaults to
# http://localhost:<PORT> (or APP_URL when the server also serves the web app).
# OPS_URL=http://localhost:3001

# LOCAL DEMO ONLY: keep accounts in this JSON file across restarts. It holds password
# hashes and authenticator keys in plain form. Refused when NODE_ENV=production.
# DATA_FILE=../.demo-data/accounts.json

# Token for the admin endpoints used by `npm run invite` and `npm run create-ops-admin`. Leave unset to disable it.
ADMIN_TOKEN=replace-with-a-long-random-value

# 1 = booking a conversion between the client's own balances also needs a fresh code.
STEP_UP_CONVERSIONS=0

# Provider API credentials. Server-side only; they never reach the app.
CURRENCYCLOUD_LOGIN_ID=replace-me
CURRENCYCLOUD_API_KEY=replace-me
EQUALS_API_KEY=replace-me
